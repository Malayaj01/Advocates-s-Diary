# SQLite file for local development. For production use a Postgres URL
# and change the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Long random string used to sign login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-long-random-string"
